// I-12, run by a machine.
//
// "No version, no external limit copied from memory. Checked against the
// registry, dated." Renovate does nothing else: it reads the registry, opens
// one PR per bump, and the date is the commit's. It is `/versions` without the
// risk that a plausible and wrong value gets through — it shows up neither at
// compile time, nor in tests, nor in review.
//
// What it does NOT do, and what stays with the human: record the value and its
// source in docs/RESEARCH-NOTES.md, in the same commit. That is why no PR is
// merged automatically.
//
// JSON5 and not JSON: this file needs to say why, and JSON cannot carry a
// comment. Renovate reads `renovate.json5` natively.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    "config:recommended",
    // Groups security updates and raises them first.
    ":enableVulnerabilityAlertsWithLabel(sécurité)",
  ],

  // The format is enforced by .claude/hooks/message_commit.py: a type from a
  // closed list, a scope in parentheses, a lowercase subject without a final
  // period. `chore(deps): update rust crate serde to v1.0.230` complies.
  semanticCommits: "enabled",
  semanticCommitType: "chore",
  semanticCommitScope: "deps",

  // The version WRITTEN in the manifest must be the one that was checked. With
  // the default strategy, a compatible bump would only touch Cargo.lock: the
  // number readable in Cargo.toml would stay the previous one, and
  // RESEARCH-NOTES would date a value that is no longer right.
  rangeStrategy: "bump",

  // Nobody reviews twenty dependency PRs. A weekly window and a low limit make
  // sure the ones that exist actually get looked at.
  schedule: ["before 9am on monday"],
  prConcurrentLimit: 5,
  prHourlyLimit: 2,
  dependencyDashboard: true,

  // Nothing merges on its own: the PR is only complete once RESEARCH-NOTES is
  // up to date, and Renovate cannot do that.
  automerge: false,

  prBodyNotes: [
    "**Before merging (I-12)**: record the version and its source in `docs/RESEARCH-NOTES.md`, with today's date, **in the same commit**. An undated bump makes the document that is authoritative on versions lie.",
    "Also check `make qualite`: several pins in this repository exist for reasons that do not show in the graph (see the comments in `Cargo.toml`).",
  ],

  ignoreDeps: [
    // rusqlite is pinned to 0.37 on purpose: sqlx pulls `sqlx-sqlite` into the
    // graph and both declare `links = "sqlite3"`, so only one version of
    // libsqlite3-sys can exist (ADR-0010). An automatic bump breaks resolution,
    // and the error message never names the cause. Raise it by hand when sqlx
    // follows.
    "rusqlite",
  ],

  packageRules: [
    // Crates that talk to a server or an AI provider change behavior on an
    // external boundary. They are reviewed, not skimmed. The label names are
    // the repository's existing GitHub labels.
    {
      matchPackageNames: ["sqlx", "reqwest", "arrow", "wasmtime", "keyring", "secrecy"],
      addLabels: ["frontière"],
    },
  ],

  // Worth noting, and intended: Renovate has no manager for
  // `rust-toolchain.toml`. The toolchain therefore stays out of its scope,
  // which matches ADR-0008 — a toolchain bump is a deliberate commit that
  // updates RESEARCH-NOTES at the same time, not a Monday notification.
}
