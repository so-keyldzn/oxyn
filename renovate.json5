// NOT ACTIVE. Renovate is not installed on this repository and has never run:
// this file is a configuration ready to be activated, not a mechanism in force.
//
// I-12 ("no version, no external limit copied from memory; checked against the
// registry, dated") is held elsewhere, and does not depend on this file:
// `make versions` refuses a version pinned in Cargo.toml or in
// apps/desktop/package.json that docs/RESEARCH-NOTES.md does not record, and
// `/versions` compares the notes with the registries.
//
// If it is activated: Renovate would read the registry and open one PR per
// bump, the date being the commit's. What it cannot do stays with the human:
// record the value and its source in docs/RESEARCH-NOTES.md, in the same
// commit — `make versions` fails the PR otherwise. That is why no PR is merged
// automatically.
//
// Before activating it: the labels it adds (`sécurité`, `frontière`) do not
// exist in the repository (labels read on 2026-10-20). Create them, or rename
// them below.
//
// JSON5 and not JSON: this file needs to say why, and JSON cannot carry a
// comment. Renovate reads `renovate.json5` natively.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    "config:recommended",
    // Groups security updates and raises them first.
    ":enableVulnerabilityAlertsWithLabel(sécurité)",
  ],

  // The format is enforced by .claude/hooks/message_commit.py: a type from a
  // closed list, a scope in parentheses, a lowercase subject without a final
  // period. `chore(deps): update rust crate serde to v1.0.230` complies.
  semanticCommits: "enabled",
  semanticCommitType: "chore",
  semanticCommitScope: "deps",

  // The version WRITTEN in the manifest must be the one that was checked. With
  // the default strategy, a compatible bump would only touch Cargo.lock: the
  // number readable in Cargo.toml would stay the previous one, and
  // RESEARCH-NOTES would date a value that is no longer right.
  rangeStrategy: "bump",

  // Nobody reviews twenty dependency PRs. A weekly window and a low limit make
  // sure the ones that exist actually get looked at.
  schedule: ["before 9am on monday"],
  prConcurrentLimit: 5,
  prHourlyLimit: 2,
  dependencyDashboard: true,

  // Nothing merges on its own: the PR is only complete once RESEARCH-NOTES is
  // up to date, and Renovate cannot do that.
  automerge: false,

  prBodyNotes: [
    "**Before merging (I-12)**: record the version and its source in `docs/RESEARCH-NOTES.md`, with today's date, **in the same commit**. An undated bump makes the document that is authoritative on versions lie.",
    "Also check `make qualite`: several pins in this repository exist for reasons that do not show in the graph (see the comments in `Cargo.toml`).",
  ],

  ignoreDeps: [
    // rusqlite is pinned to 0.37 on purpose: sqlx pulls `sqlx-sqlite` into the
    // graph and both declare `links = "sqlite3"`, so only one version of
    // libsqlite3-sys can exist (ADR-0010). An automatic bump breaks resolution,
    // and the error message never names the cause. Raise it by hand when sqlx
    // follows.
    "rusqlite",
  ],

  packageRules: [
    // Crates that talk to a server or an AI provider change behavior on an
    // external boundary. They are reviewed, not skimmed. The label does not
    // exist yet (see the header).
    {
      matchPackageNames: ["sqlx", "reqwest", "arrow", "wasmtime", "keyring", "secrecy"],
      addLabels: ["frontière"],
    },
  ],

  // Prebuilt Rust tools are shell variables rather than package manifests.
  // Renovate raises version bumps; the required per-platform checksums stay a
  // deliberate review step and make the workflow fail until they are updated.
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^\\.github\\/workflows\\/qualite\\.yml$/"],
      matchStrings: ["# renovate: cargo-deny\\n\\s*version=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      depNameTemplate: "EmbarkStudios/cargo-deny",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^\\.github\\/workflows\\/qualite\\.yml$/"],
      matchStrings: ["# renovate: cargo-nextest\\n\\s*version=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      depNameTemplate: "nextest-rs/nextest",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^cargo-nextest-(?<version>.*)$",
    },
  ],

  // Worth noting, and intended: Renovate has no manager for
  // `rust-toolchain.toml`. The toolchain therefore stays out of its scope,
  // which matches ADR-0008 — a toolchain bump is a deliberate commit that
  // updates RESEARCH-NOTES at the same time, not a Monday notification.
}
