{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oxyn",
  "version": "0.0.1",
  "identifier": "dev.oxyn.desktop",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../apps/desktop/dist/client",
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": "../../apps/desktop",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": "../../apps/desktop"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Oxyn",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
