#!/usr/bin/env python3
"""Says which areas of the repository a pull request touches: `rust`,
`front`, `docs`.

CI uses it to skip, on a PR, the jobs whose area is not touched (ADR-0045).
The classification leans one way only: a file this script cannot classify
triggers **everything**. An omission then costs runner minutes, never a check.

Outside the `pull_request` event — push to `main`, manual run —, every area is
returned without looking at anything: that is the safety net.

    script/zones-ci HEAD^1          compares HEAD with this commit
    GITHUB_EVENT_NAME=push script/zones-ci HEAD^1   every area

Writes `rust=true|false` and `front=true|false` to `$GITHUB_OUTPUT` when the
variable exists, and prints the details in every case.
"""

from __future__ import annotations

import os
import subprocess
import sys

ZONES = ("rust", "front", "docs")

# What decides how everything else is built or checked: the Makefile, the
# workflows, the Cargo graph, the toolchain, the foundation and its scripts. A
# prefix ends with `/`, a file does not.
CROSS_CUTTING = (
    "Makefile",
    ".github/",
    "Cargo.toml",
    "Cargo.lock",
    ".cargo/",
    ".config/",
    "rust-toolchain.toml",
    "clippy.toml",
    "deny.toml",
    "renovate.json5",
    ".claude/",
    ".agents/",
    "script/",
)


def _matches(path_str: str, pattern: str) -> bool:
    return path_str.startswith(pattern) if pattern.endswith("/") else path_str == pattern


def zones_of(path_str: str) -> set[str]:
    if any(_matches(path_str, m) for m in CROSS_CUTTING):
        return set(ZONES)
    if path_str.startswith("apps/desktop/"):
        return {"front"}
    if path_str.startswith(("crates/", "drivers/")):
        return {"rust"}
    if path_str.startswith("docs/") or path_str.endswith(".md"):
        return {"docs"}
    return set(ZONES)


def touched_zones(event: str, file_list: list[str]) -> set[str]:
    if event != "pull_request":
        return set(ZONES)
    touched: set[str] = set()
    for path_str in file_list:
        touched |= zones_of(path_str)
    return touched


def main(arguments: list[str]) -> int:
    if len(arguments) != 1:
        print("usage: script/zones-ci <base commit>", file=sys.stderr)
        return 2
    event = os.environ.get("GITHUB_EVENT_NAME", "pull_request")
    file_list = subprocess.run(
        ["git", "diff", "--name-only", arguments[0], "HEAD"],
        check=True, capture_output=True, text=True,
    ).stdout.splitlines()
    touched = touched_zones(event, file_list)

    print(f"Event: {event}, {len(file_list)} file(s) modified.")
    for path_str in file_list:
        print(f"  {path_str}  →  {', '.join(sorted(zones_of(path_str)))}")
    for zone in ZONES:
        print(f"{zone:6} {'touched' if zone in touched else 'not touched'}")

    output = os.environ.get("GITHUB_OUTPUT")
    if output:
        with open(output, "a", encoding="utf-8") as f:
            for zone in ("rust", "front"):
                f.write(f"{zone}={'true' if zone in touched else 'false'}\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
