#!/usr/bin/env python3
"""Says which areas of the repository a pull request touches: `rust`,
`front`, `docs`.

CI uses it to skip, on a PR, the jobs whose area is not touched (ADR-0045).
The classification leans one way only: a file this script cannot classify
triggers **everything**. An omission then costs runner minutes, never a check.

Outside the `pull_request` event — push to `main`, manual run —, every area is
returned without looking at anything: that is the safety net.

    script/zones-ci HEAD^1          compares HEAD with this commit
    GITHUB_EVENT_NAME=push script/zones-ci HEAD^1   every area

Writes `rust=true|false` and `front=true|false` to `$GITHUB_OUTPUT` when the
variable exists, and prints the details in every case.
"""

from __future__ import annotations

import os
import subprocess
import sys

ZONES = ("rust", "front", "docs")

# What decides how everything else is built or checked: the Makefile, the
# workflows, the Cargo graph, the toolchain, the foundation and its scripts. A
# prefix ends with `/`, a file does not.
TRANSVERSAUX = (
    "Makefile",
    ".github/",
    "Cargo.toml",
    "Cargo.lock",
    ".cargo/",
    ".config/",
    "rust-toolchain.toml",
    "clippy.toml",
    "deny.toml",
    "renovate.json5",
    ".claude/",
    ".agents/",
    "script/",
)


def _correspond(chemin: str, motif: str) -> bool:
    return chemin.startswith(motif) if motif.endswith("/") else chemin == motif


def zones_de(chemin: str) -> set[str]:
    if any(_correspond(chemin, m) for m in TRANSVERSAUX):
        return set(ZONES)
    if chemin.startswith("apps/desktop/"):
        return {"front"}
    if chemin.startswith(("crates/", "drivers/")):
        return {"rust"}
    if chemin.startswith("docs/") or chemin.endswith(".md"):
        return {"docs"}
    return set(ZONES)


def zones_touchees(evenement: str, fichiers: list[str]) -> set[str]:
    if evenement != "pull_request":
        return set(ZONES)
    touchees: set[str] = set()
    for chemin in fichiers:
        touchees |= zones_de(chemin)
    return touchees


def principal(arguments: list[str]) -> int:
    if len(arguments) != 1:
        print("usage: script/zones-ci <base commit>", file=sys.stderr)
        return 2
    evenement = os.environ.get("GITHUB_EVENT_NAME", "pull_request")
    fichiers = subprocess.run(
        ["git", "diff", "--name-only", arguments[0], "HEAD"],
        check=True, capture_output=True, text=True,
    ).stdout.splitlines()
    touchees = zones_touchees(evenement, fichiers)

    print(f"Event: {evenement}, {len(fichiers)} file(s) modified.")
    for chemin in fichiers:
        print(f"  {chemin}  →  {', '.join(sorted(zones_de(chemin)))}")
    for zone in ZONES:
        print(f"{zone:6} {'touched' if zone in touchees else 'not touched'}")

    sortie = os.environ.get("GITHUB_OUTPUT")
    if sortie:
        with open(sortie, "a", encoding="utf-8") as f:
            for zone in ("rust", "front"):
                f.write(f"{zone}={'true' if zone in touchees else 'false'}\n")
    return 0


if __name__ == "__main__":
    sys.exit(principal(sys.argv[1:]))
