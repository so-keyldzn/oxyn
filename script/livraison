#!/usr/bin/env python3
"""Les deux gestes du workflow de livraison qui touchent une release GitHub.

`.github/workflows/livraison.yml` promet deux choses en tête : les paquets ne
vont que dans une release en BROUILLON, et le tag porte la version de
`crates/oxyn-desktop/tauri.conf.json`. Écrites en shell dans le workflow, ni
l'une ni l'autre n'était vérifiée, et rien ne pouvait le tester sans pousser un
tag. Elles vivent donc ici, testées par `script/test_livraison.py`.

    livraison brouillon <tag> <dépôt>            vérifie le tag, puis crée ou
                                                 retrouve le brouillon
    livraison deposer <tag> <dépôt> <fichier>…   dépose chaque fichier dans le
                                                 brouillon, un par un

**Le tag.** Il vaut exactement `v` suivi de la version configurée, suffixe de
préversion compris : `0.1.0-rc.1` ⇔ `v0.1.0-rc.1`. Rien n'est corrigé en
silence — ni le tag, ni la version : un écart est une erreur humaine, et c'est
à l'humain de dire lequel des deux est juste. Une version à suffixe crée un
brouillon marqué préversion.

**Le brouillon.** Une release déjà publiée est refusée, au premier job comme
avant chaque fichier : un humain peut la publier pendant les builds, qui durent
une heure. Le statut est relu juste avant chaque envoi, et encore après. `gh`
n'offre pas d'envoi conditionnel : une publication tombée pendant l'envoi
lui-même reçoit ce seul fichier en plus — aucun n'est retiré ni remplacé — et
le job échoue en le disant, sans rien déposer d'autre.

**Un fichier déjà présent** fait échouer le dépôt, sans rien toucher. Aucun
`--clobber` : il supprime l'ancien fichier avant d'envoyer le nouveau, et un
envoi qui échoue — ou une publication tombée entre la vérification et l'envoi —
laisse une release publique sans son paquet. Remplacer un paquet d'un brouillon
est une décision : la supprimer du brouillon à la main, puis relancer le job.

`gh` est lu dans `$GH` s'il est défini — c'est ce qui permet aux tests de le
simuler.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

RACINE = Path(__file__).resolve().parents[1]
CONFIG_TAURI = RACINE / "crates" / "oxyn-desktop" / "tauri.conf.json"


class Refus(Exception):
    """Une condition du contrat n'est pas remplie : le job doit échouer."""


def gh(*args: str) -> subprocess.CompletedProcess[str]:
    commande = [os.environ.get("GH", "gh"), *args]
    return subprocess.run(commande, capture_output=True, text=True, check=False)


def version_configuree(config: Path) -> str:
    try:
        version = json.loads(config.read_text(encoding="utf-8")).get("version")
    except (OSError, ValueError) as erreur:
        raise Refus(f"{config} illisible : {erreur}") from erreur
    if not isinstance(version, str) or not version:
        raise Refus(f"{config} : pas de champ `version`")
    # Tauri accepte aussi un chemin vers un package.json : le tag se comparerait
    # alors à un nom de fichier.
    if version.endswith(".json"):
        raise Refus(f"{config} : `version` renvoie à {version}, non pris en charge ici")
    return version


def verifier_tag(tag: str, config: Path) -> bool:
    """Refuse un tag qui n'est pas `v<version>` ; dit si c'est une préversion."""
    version = version_configuree(config)
    attendu = f"v{version}"
    if tag != attendu:
        raise Refus(
            f"le tag {tag} ne correspond pas à la version {version} de {config.name} : "
            f"attendu {attendu}. Rien n'est créé ; corriger le tag ou la version."
        )
    # Le suffixe de préversion précède `+` ; un tiret dans les métadonnées de
    # build (`1.0.0+build-1`) ne fait pas une préversion.
    return "-" in version.split("+", 1)[0]


def lire_release(tag: str, depot: str) -> dict | None:
    """La release du tag, ou None si elle n'existe pas encore."""
    vue = gh("release", "view", tag, "--repo", depot, "--json", "isDraft,assets")
    if vue.returncode != 0:
        if "release not found" in vue.stderr:
            return None
        raise Refus(f"lecture de la release {tag} impossible : {vue.stderr.strip()}")
    try:
        release = json.loads(vue.stdout)
    except ValueError as erreur:
        raise Refus(f"réponse illisible de gh release view : {erreur}") from erreur
    if not isinstance(release, dict) or not isinstance(release.get("isDraft"), bool):
        raise Refus("gh release view ne dit pas si la release est un brouillon")
    return release


def exiger_brouillon(tag: str, depot: str) -> dict:
    release = lire_release(tag, depot)
    if release is None:
        raise Refus(f"aucune release {tag} : le job brouillon ne l'a pas créée")
    if not release["isDraft"]:
        raise Refus(
            f"la release {tag} est publiée : aucun paquet n'y est déposé. "
            "Une release publiée ne se complète pas par ce workflow."
        )
    return release


def exiger_brouillon_apres_envoi(tag: str, depot: str) -> bool:
    release = lire_release(tag, depot)
    return release is not None and release["isDraft"]


def brouillon(tag: str, depot: str, config: Path) -> None:
    preversion = verifier_tag(tag, config)
    if lire_release(tag, depot) is None:
        # `--verify-tag` : la release ne s'attache qu'à un tag qui existe déjà
        # sur le dépôt, jamais à un tag que gh créerait lui-même.
        options = ["--draft", "--verify-tag", "--generate-notes", "--title", f"Oxyn {tag}"]
        if preversion:
            options.append("--prerelease")
        creation = gh("release", "create", tag, "--repo", depot, *options)
        if creation.returncode != 0:
            raise Refus(f"création du brouillon {tag} impossible : {creation.stderr.strip()}")
    exiger_brouillon(tag, depot)
    print(f"Brouillon {tag} prêt.")


def deposer(tag: str, depot: str, fichiers: list[Path], config: Path) -> None:
    verifier_tag(tag, config)
    if not fichiers:
        raise Refus("aucun fichier à déposer")
    for fichier in fichiers:
        release = exiger_brouillon(tag, depot)
        presents = {a.get("name") for a in release.get("assets") or [] if isinstance(a, dict)}
        if fichier.name in presents:
            raise Refus(
                f"{fichier.name} est déjà dans le brouillon {tag} : il n'est pas remplacé. "
                "Le supprimer du brouillon, puis relancer le job."
            )
        envoi = gh("release", "upload", tag, str(fichier), "--repo", depot)
        if envoi.returncode != 0:
            raise Refus(f"envoi de {fichier.name} impossible : {envoi.stderr.strip()}")
        # Retirer le fichier serait une écriture de plus sur une release
        # publique : on s'arrête et on le dit.
        if not exiger_brouillon_apres_envoi(tag, depot):
            raise Refus(
                f"la release {tag} a été publiée pendant l'envoi de {fichier.name}, "
                "qui y a été ajouté ; rien d'autre n'est déposé. Vérifier la release."
            )
        print(f"{fichier.name} déposé dans le brouillon {tag}.")


def main(args: list[str]) -> int:
    config = Path(os.environ.get("OXYN_CONFIG_TAURI", CONFIG_TAURI))
    try:
        match args:
            case ["brouillon", tag, depot]:
                brouillon(tag, depot, config)
            case ["deposer", tag, depot, *fichiers]:
                deposer(tag, depot, [Path(f) for f in fichiers], config)
            case _:
                print(__doc__, file=sys.stderr)
                return 2
    except Refus as refus:
        print(f"livraison : {refus}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
