#!/usr/bin/env python3
"""Creates an already compliant crate, rather than relying on memory.

CLAUDE.md names the trap: a `paths:` rule loads when Claude *reads* a matching
file, **not when it creates one**. The first file of a new directory is
therefore written without its rule — and a manifest without
`[lints] workspace = true` makes nothing fail: the crate compiles, clippy stays
silent on it, and nobody notices for months.

This script writes what the manifest must contain, and attaches the crate to
the workspace. What remains to do afterwards is printed, because that part
needs a choice.

    script/nouvelle-crate oxyn-thing "What this crate is about"
"""

from __future__ import annotations

import re
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
WORKSPACE_MANIFEST = REPO_ROOT / "Cargo.toml"

NAME_PATTERN = re.compile(r"^oxyn-[a-z0-9]+(?:-[a-z0-9]+)*$")

# The names the split forbids. It is not a matter of taste: a catch-all crate
# ends up a dependency of all the others, and the graph we spent time directing
# stops meaning anything.
CATCH_ALL = {"utils", "util", "common", "commons", "helpers", "misc", "core-utils"}

MANIFEST_TEMPLATE = """[package]
name = "{nom}"
description = "{description}"
version.workspace = true
edition.workspace = true
rust-version.workspace = true
license.workspace = true
publish.workspace = true
repository.workspace = true

[lints]
workspace = true

[dependencies]
oxyn-core.workspace = true
thiserror.workspace = true

[dev-dependencies]
rstest.workspace = true
"""

# The marker is assembled so that this script does not flag itself to
# `script/verifier-todo`: it is not remaining work, it is a template.
LIB_TEMPLATE = (
    "//! TO"
    + "DO(phase 0) : state what this crate is about, in one sentence,\n"
    + "//! before the first public item.\n"
)


def problem(message: str) -> None:
    print(f"ERROR  {message}", file=sys.stderr)
    raise SystemExit(1)


def destination(item_name: str) -> Path:
    """`drivers/` for a protocol implementation, `crates/` otherwise.

    The placement is not cosmetic: `drivers/*` is what lets one say "one driver
    per protocol" and check it at a glance."""
    if item_name.startswith("oxyn-driver-"):
        return REPO_ROOT / "drivers" / item_name
    return REPO_ROOT / "crates" / item_name


def attach_to_workspace(item_name: str, relative_path: str) -> bool:
    """Adds the crate to `[workspace.dependencies]`.

    `members = ["crates/*", "drivers/*"]` already takes it as a member; what is
    missing is the entry that lets other crates write `{nom}.workspace = true`.
    Without it, the first internal dependency would be written with a hard-coded
    `path`, and the workspace would stop being the single source of versions."""
    body = WORKSPACE_MANIFEST.read_text(encoding="utf-8")
    if re.search(rf"^{re.escape(item_name)}\s*=", body, re.MULTILINE):
        return False

    lines = body.splitlines(keepends=True)
    pattern = re.compile(r'^(oxyn-[a-z0-9-]+)\s*= \{ path = "([^"]+)"')
    # The entry goes after the last one of the same directory: the block lists
    # `crates/` then `drivers/`, and a driver slipped among the core crates
    # would make the only overview of the workspace we have lie.
    directory = relative_path.split("/", 1)[0]
    matches = [
        i
        for i, line in enumerate(lines)
        if (m := pattern.match(line)) and m.group(2).startswith(f"{directory}/")
    ]
    last_one = max(matches, default=None)
    if last_one is None:
        problem(
            "cannot locate the internal crates block in Cargo.toml: "
            f"add `{item_name} = {{ path = \"{relative_path}\" }}` by hand"
        )

    # The alignment of the block's `=` is kept by hand in this manifest;
    # reproducing it avoids a formatting diff on the next commit.
    width = max(
        len(pattern.match(line).group(1)) for line in lines if pattern.match(line)
    )
    lines.insert(
        last_one + 1,
        f"{item_name.ljust(width)} = {{ path = \"{relative_path}\" }}\n",
    )
    WORKSPACE_MANIFEST.write_text("".join(lines), encoding="utf-8")
    return True


def main(arguments: list[str]) -> int:
    if len(arguments) != 2:
        print(__doc__)
        return 1

    item_name, description = arguments
    if not NAME_PATTERN.match(item_name):
        problem(
            f"\"{item_name}\": the name must be `oxyn-<subject>`, lowercase, "
            "with hyphens."
        )
    subject = item_name.removeprefix("oxyn-")
    if subject in CATCH_ALL:
        problem(
            f"\"{subject}\" is a catch-all name. A name one cannot choose is a "
            "split one could not make: name the crate after its subject, or "
            "put the code in an existing crate."
        )
    if not description.strip():
        problem(
            "the description is mandatory: it is what says, in "
            "`cargo metadata` and in docs/ARCHITECTURE.md, why this crate "
            "exists on its own."
        )

    crate_root = destination(item_name)
    if crate_root.exists():
        problem(f"{crate_root.relative_to(REPO_ROOT)} already exists.")

    (crate_root / "src").mkdir(parents=True)
    (crate_root / "Cargo.toml").write_text(
        MANIFEST_TEMPLATE.format(item_name=item_name, description=description.strip()),
        encoding="utf-8",
    )
    (crate_root / "src" / "lib.rs").write_text(LIB_TEMPLATE, encoding="utf-8")

    relative = crate_root.relative_to(REPO_ROOT).as_posix()
    attached = attach_to_workspace(item_name, relative)

    print(f"Crate created: {relative}/")
    print("  Cargo.toml     inherits the workspace lints and versions")
    print("  src/lib.rs     to fill in")
    if attached:
        print(f"  Cargo.toml     `{item_name}` added to [workspace.dependencies]")

    print()
    print("What remains, and needs a choice:")
    print("  1. docs/ARCHITECTURE.md — the crate tree is authoritative there;")
    print("     a crate missing from the document is a divergence, not an oversight.")
    if item_name.startswith("oxyn-driver-"):
        print("  2. /driver — the driver contract loads the procedure explicitly.")
    else:
        print("  2. /implementer — `paths:` rules do not load when a file is")
        print("     created; the command loads the procedure.")
    print("  3. Every external dependency goes through /versions and RESEARCH-NOTES,")
    print("     in the same commit (I-12).")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
