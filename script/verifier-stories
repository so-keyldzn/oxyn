#!/usr/bin/env python3
"""Refuses an Oxyn component that no story renders.

`.claude/rules/front.md` says it: a component of `src/components/oxyn` has its
stories, and its stories are its tests — `make front` renders them in
Chromium, axe included. A component without a story fails nowhere: it simply
escapes axe and every `play`, and nobody notices.

What a component is, what covers it and what exempts it is written once, in
`.claude/rules/front.md` § "Every Oxyn component has its stories": this script
applies it, it does not redefine it.

Called by `make front-controles`, hence by `make front` and `make qualite`.
"""

from __future__ import annotations

import re
import sys
from pathlib import Path

RACINE = Path(__file__).resolve().parents[1]
COMPOSANTS = RACINE / "apps" / "desktop" / "src" / "components" / "oxyn"

# Pieces that only make sense inside their parent: they are rendered, axe
# included, by the parent's stories. Each entry names that story; an entry
# without it would be a hole, not an exemption.
EXEMPTS = {
    "assistant-code-block": "rendered by assistant-rich-blocks.stories.tsx, via AssistantMarkdown",
    "assistant-mermaid": "rendered by assistant-rich-blocks.stories.tsx, via AssistantMarkdown",
    "assistant-mention-menu": "Lexical plugin, rendered by assistant-composer.stories.tsx",
    "assistant-mention-node": "Lexical node, rendered by assistant-composer.stories.tsx",
    "result-chart-cartesian": "rendered by result-chart.stories.tsx, via ResultChartView",
    "result-chart-polar": "rendered by result-chart.stories.tsx, via ResultChartView",
    "result-chart-picker": "rendered by result-chart.stories.tsx, via ResultChartView",
    # TODO(2026-10-15, unblocked by merging the batch that modifies assistant-exchange.tsx):
    # write assistant-exchange.stories.tsx for ExchangeView, rendered meanwhile
    # by assistant-view.stories.tsx.
    "assistant-exchange": "rendered by assistant-view.stories.tsx, until it has its own",
}

MOTIF_IMPORT = re.compile(
    r"""from\s+["'](?:\./|@/components/oxyn/)([\w.-]+)["']"""
)


def composants() -> list[str]:
    return sorted(
        f.stem
        for f in COMPOSANTS.glob("*.tsx")
        if not f.name.endswith((".stories.tsx", ".test.tsx"))
    )


def importes_par_une_story() -> set[str]:
    importes: set[str] = set()
    for story in COMPOSANTS.glob("*.stories.tsx"):
        importes.update(MOTIF_IMPORT.findall(story.read_text(encoding="utf-8")))
    return importes


def principal() -> int:
    noms = composants()
    couverts = importes_par_une_story()
    erreurs = [
        f"{nom}.tsx: no story imports it — write {nom}.stories.tsx"
        for nom in noms
        if nom not in couverts and nom not in EXEMPTS
    ]
    # An exemption that no longer serves is removed: otherwise it will one day
    # cover, without anyone deciding it, an unrelated component.
    erreurs += [
        f"{nom}: stale exemption — the file no longer exists or a story imports it"
        for nom in EXEMPTS
        if nom not in noms or nom in couverts
    ]

    for message in erreurs:
        print(f"ERROR          {message}")

    if erreurs:
        print(f"\nStories: {len(erreurs)} component(s) without a story.")
        return 1
    print(f"Stories: {len(noms)} components, each rendered by a story.")
    return 0


if __name__ == "__main__":
    sys.exit(principal())
