#!/usr/bin/env python3
"""The licenses of the dependencies the application ships.

Two subcommands, because they read the same thing:

    licences-tierces verifier-npm
        refuses a production npm dependency whose license is not accepted.
        It is `make licences-npm`, the front-end counterpart of `make deny`;
        `make qualite` calls it.

    licences-tierces generer [--exiger] <output.json>
        writes the notices of the Rust dependencies of `oxyn-desktop` (through
        `cargo-about`) and of the production npm dependencies of
        `apps/desktop`. The application displays them in Settings > About
        (ADR-0044).

The list of accepted licenses is **the one in `deny.toml`**, and this script
does not keep a second one: a license is accepted there because it is
compatible with the GPLv3, and that verdict must be made in one place only.
`apps/desktop/licences-npm.toml` only adds what is specific to npm, each line
with its reason.

Only **production** dependencies count (`pnpm licenses list --prod`): a build
or test tool is not distributed with the application.

With `cargo-about` missing, `generer` warns without writing anything, like
`make deny` without `cargo-deny`: a gate that fails on an optional tool ends up
bypassed. With `--exiger`, which a release build passes, it fails: a binary
distributed without its notices violates the licenses it embeds.
"""

from __future__ import annotations

import json
import re
import shutil
import subprocess
import sys
import tempfile
import tomllib
from dataclasses import dataclass
from pathlib import Path

RACINE = Path(__file__).resolve().parents[1]
FRONT = RACINE / "apps" / "desktop"
DENY = RACINE / "deny.toml"
CONFIG_NPM = FRONT / "licences-npm.toml"
MANIFESTE_APP = RACINE / "crates" / "oxyn-desktop" / "Cargo.toml"

# The version read from the registry and dated in RESEARCH-NOTES (I-12).
# Another version might produce the same file; nothing guarantees it, and a
# difference in notices shows in no test.
VERSION_CARGO_ABOUT = "0.9.2"

# A license file, whatever the package's convention: `LICENSE`, `license.md`,
# `LICENCE-MIT`, `COPYING`, `NOTICE`…
MOTIF_FICHIER_LICENCE = re.compile(r"^(licen[cs]e|copying|notice)([-._].*)?$", re.IGNORECASE)


# --- SPDX expressions ----------------------------------------------------------


def _jetons(expression: str) -> list[str]:
    return re.findall(r"\(|\)|[^\s()]+", expression)


def acceptee(expression: str, permises: set[str]) -> bool:
    """True if one of the expression's alternatives only uses allowed
    licenses. `A OR B`: one is enough; `A AND B`: both are needed; `A WITH E`
    is a term in its own right, as in `deny.toml`."""
    jetons = _jetons(expression)
    position = 0

    def terme() -> bool:
        nonlocal position
        if position >= len(jetons):
            raise ValueError(expression)
        jeton = jetons[position]
        position += 1
        if jeton == "(":
            valeur = ou()
            if position >= len(jetons) or jetons[position] != ")":
                raise ValueError(expression)
            position += 1
            return valeur
        if position + 1 < len(jetons) and jetons[position] == "WITH":
            jeton = f"{jeton} WITH {jetons[position + 1]}"
            position += 2
        return jeton in permises

    def et() -> bool:
        nonlocal position
        valeur = terme()
        while position < len(jetons) and jetons[position] == "AND":
            position += 1
            valeur = terme() and valeur
        return valeur

    def ou() -> bool:
        nonlocal position
        valeur = et()
        while position < len(jetons) and jetons[position] == "OR":
            position += 1
            valeur = et() or valeur
        return valeur

    try:
        valeur = ou()
    except ValueError:
        return False
    return valeur and position == len(jetons)


# --- What is accepted -----------------------------------------------------------


def licences_de_deny() -> set[str]:
    return set(tomllib.loads(DENY.read_text(encoding="utf-8"))["licenses"]["allow"])


@dataclass
class ConfigNpm:
    permises: set[str]
    exceptions: dict[str, set[str]]
    # (name, version) → license: the package does not declare its own, or
    # declares it wrongly. Pinned to a version: a bump requires rereading.
    precisions: dict[tuple[str, str], str]


def lire_config_npm() -> ConfigNpm:
    brut = tomllib.loads(CONFIG_NPM.read_text(encoding="utf-8"))
    return ConfigNpm(
        permises=licences_de_deny() | set(brut.get("allow", [])),
        exceptions={e["name"]: set(e["allow"]) for e in brut.get("exceptions", [])},
        precisions={(c["name"], c["version"]): c["license"] for c in brut.get("clarify", [])},
    )


# --- The npm dependencies -----------------------------------------------------


@dataclass
class PaquetNpm:
    nom: str
    version: str
    licence: str
    chemin: Path


def paquets_npm() -> list[PaquetNpm]:
    sortie = subprocess.run(
        ["pnpm", "licenses", "list", "--prod", "--json"],
        cwd=FRONT,
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    paquets: list[PaquetNpm] = []
    for licence, entrees in json.loads(sortie).items():
        for entree in entrees:
            for version, chemin in zip(entree["versions"], entree["paths"], strict=True):
                paquets.append(PaquetNpm(entree["name"], version, licence, Path(chemin)))
    return sorted(paquets, key=lambda p: (p.nom, p.version))


def verifier_npm() -> int:
    config = lire_config_npm()
    paquets = paquets_npm()
    refus: list[str] = []
    utilisees: set[object] = set()
    for paquet in paquets:
        cle = (paquet.nom, paquet.version)
        licence = config.precisions.get(cle, paquet.licence)
        if cle in config.precisions:
            utilisees.add(cle)
        permises = config.permises | config.exceptions.get(paquet.nom, set())
        if paquet.nom in config.exceptions:
            utilisees.add(paquet.nom)
        if not acceptee(licence, permises):
            refus.append(f"  {paquet.nom}@{paquet.version}: \"{licence}\"")

    perimees = [f"  exception {n}" for n in config.exceptions if n not in utilisees]
    perimees += [f"  clarify {n}@{v}" for (n, v) in config.precisions if (n, v) not in utilisees]

    if refus:
        print("Refused npm licenses (production dependencies of apps/desktop):")
        print("\n".join(refus))
        print(
            "\nA license is accepted in deny.toml, after checking that it is\n"
            "compatible with the GPLv3 (ADR-0044); an exception specific to a package,\n"
            "or a wrongly declared license, in apps/desktop/licences-npm.toml."
        )
    if perimees:
        print("Entries of apps/desktop/licences-npm.toml that no longer serve:")
        print("\n".join(perimees))
    if refus or perimees:
        return 1
    print(f"npm licenses: {len(paquets)} production packages, all accepted.")
    return 0


# --- The notices --------------------------------------------------------------


def _cible_hote() -> str:
    sortie = subprocess.run(["rustc", "-vV"], check=True, capture_output=True, text=True).stdout
    for ligne in sortie.splitlines():
        if ligne.startswith("host: "):
            return ligne.removeprefix("host: ")
    raise SystemExit("rustc -vV does not give the host target")


def mentions_rust() -> list[dict[str, object]]:
    """The dependencies of `oxyn-desktop` for the host target, the one of the
    binary being built, without build or development dependencies."""
    cible = _cible_hote()
    # `--frozen` makes the result identical online and offline; it assumes the
    # sources are present, which this `fetch` ensures. Every target: the
    # `cargo metadata` that `cargo about` runs resolves the graph of every
    # platform in the lockfile, and a runner with an empty cache failed on an
    # Android crate.
    subprocess.run(
        ["cargo", "fetch", "--locked", "--manifest-path", str(MANIFESTE_APP)],
        cwd=RACINE,
        check=True,
    )
    with tempfile.TemporaryDirectory() as dossier:
        config = Path(dossier) / "about.toml"
        config.write_text(
            "accepted = " + json.dumps(sorted(licences_de_deny())) + "\n"
            "ignore-build-dependencies = true\n"
            "ignore-dev-dependencies = true\n"
            # Our GPL crates, `publish = false`: same exemption as in
            # deny.toml, and for the same reason.
            "private = { ignore = true }\n",
            encoding="utf-8",
        )
        sortie = Path(dossier) / "rust.json"
        subprocess.run(
            [
                "cargo", "about", "generate", "--format", "json", "--frozen", "--fail",
                "-c", str(config), "-m", str(MANIFESTE_APP), "--target", cible,
                "-o", str(sortie),
            ],
            cwd=RACINE,
            check=True,
        )
        brut = json.loads(sortie.read_text(encoding="utf-8"))

    mentions: list[dict[str, object]] = []
    for licence in brut["licenses"]:
        # The workspace crates have no `source`: they are ours, and NOTICE
        # gives their license.
        paquets = sorted(
            {
                (u["crate"]["name"], u["crate"]["version"])
                for u in licence["used_by"]
                if u["crate"].get("source")
            }
        )
        if paquets:
            mentions.append(
                {
                    "license": licence["id"],
                    "name": licence["name"],
                    "text": licence["text"].strip("\n"),
                    "packages": [
                        {"ecosystem": "cargo", "name": n, "version": v} for n, v in paquets
                    ],
                }
            )
    return mentions


def _texte_de_licence(dossier: Path) -> str | None:
    if not dossier.is_dir():
        return None
    fichiers = sorted(f for f in dossier.iterdir() if f.is_file() and MOTIF_FICHIER_LICENCE.match(f.name))
    textes = [f.read_text(encoding="utf-8", errors="replace").strip("\n") for f in fichiers]
    return "\n\n".join(textes) or None


def mentions_npm() -> list[dict[str, object]]:
    config = lire_config_npm()
    groupes: dict[tuple[str, str], list[PaquetNpm]] = {}
    for paquet in paquets_npm():
        licence = config.precisions.get((paquet.nom, paquet.version), paquet.licence)
        # Without a file, the declared expression remains: it is what the
        # package publishes of its license, and hiding it would be worse.
        texte = _texte_de_licence(paquet.chemin) or f"Licensed under {licence}. The package ships no license file."
        groupes.setdefault((licence, texte), []).append(paquet)
    return [
        {
            "license": licence,
            "name": licence,
            "text": texte,
            "packages": [
                {"ecosystem": "npm", "name": p.nom, "version": p.version} for p in paquets
            ],
        }
        for (licence, texte), paquets in groupes.items()
    ]


def generer(sortie: Path, exiger: bool) -> int:
    outil = shutil.which("cargo-about")
    version = (
        subprocess.run(["cargo", "about", "--version"], capture_output=True, text=True).stdout.split()[-1:]
        if outil
        else []
    )
    if version != [VERSION_CARGO_ABOUT]:
        trouvee = version[0] if version else "missing"
        print(
            f"cargo-about {VERSION_CARGO_ABOUT} required ({trouvee}): the third-party "
            "license notices were NOT generated."
        )
        print(f"  To install it: cargo install --locked cargo-about@{VERSION_CARGO_ABOUT}")
        return 1 if exiger else 0

    mentions = mentions_rust() + mentions_npm()
    mentions.sort(key=lambda m: (str(m["license"]).lower(), m["packages"][0]["name"]))  # type: ignore[index]
    sortie.parent.mkdir(parents=True, exist_ok=True)
    sortie.write_text(
        json.dumps({"version": 1, "notices": mentions}, ensure_ascii=False, indent=1) + "\n",
        encoding="utf-8",
    )
    paquets = sum(len(m["packages"]) for m in mentions)  # type: ignore[arg-type]
    print(f"Third-party notices: {paquets} packages, {len(mentions)} texts → {sortie.relative_to(RACINE)}")
    return 0


def principal(arguments: list[str]) -> int:
    if arguments == ["verifier-npm"]:
        return verifier_npm()
    if arguments[:1] == ["generer"]:
        reste = arguments[1:]
        exiger = "--exiger" in reste
        chemins = [a for a in reste if a != "--exiger"]
        if len(chemins) == 1:
            return generer((RACINE / chemins[0]).resolve(), exiger)
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(principal(sys.argv[1:]))
