#!/usr/bin/env python3
"""The licenses of the dependencies the application ships.

Two subcommands, because they read the same thing:

    licences-tierces verifier-npm
        refuses a production npm dependency whose license is not accepted.
        It is `make licences-npm`, the front-end counterpart of `make deny`;
        `make qualite` calls it.

    licences-tierces generer [--exiger] <output.json>
        writes the notices of the Rust dependencies of `oxyn-desktop` (through
        `cargo-about`) and of the production npm dependencies of
        `apps/desktop`. The application displays them in Settings > About
        (ADR-0044).

The list of accepted licenses is **the one in `deny.toml`**, and this script
does not keep a second one: a license is accepted there because it is
compatible with the GPLv3, and that verdict must be made in one place only.
`apps/desktop/licences-npm.toml` only adds what is specific to npm, each line
with its reason.

Only **production** dependencies count (`pnpm licenses list --prod`): a build
or test tool is not distributed with the application.

With `cargo-about` missing, `generer` warns without writing anything, like
`make deny` without `cargo-deny`: a gate that fails on an optional tool ends up
bypassed. With `--exiger`, which a release build passes, it fails: a binary
distributed without its notices violates the licenses it embeds.
"""

from __future__ import annotations

import json
import re
import shutil
import subprocess
import sys
import tempfile
import tomllib
from dataclasses import dataclass
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
FRONT = REPO_ROOT / "apps" / "desktop"
DENY = REPO_ROOT / "deny.toml"
CONFIG_NPM = FRONT / "licences-npm.toml"
APP_MANIFEST = REPO_ROOT / "crates" / "oxyn-desktop" / "Cargo.toml"

# The version read from the registry and dated in RESEARCH-NOTES (I-12).
# Another version might produce the same file; nothing guarantees it, and a
# difference in notices shows in no test.
VERSION_CARGO_ABOUT = "0.9.2"

# A license file, whatever the package's convention: `LICENSE`, `license.md`,
# `LICENCE-MIT`, `COPYING`, `NOTICE`…
LICENSE_FILE_PATTERN = re.compile(r"^(licen[cs]e|copying|notice)([-._].*)?$", re.IGNORECASE)


# --- SPDX expressions ----------------------------------------------------------


def _tokens(expression: str) -> list[str]:
    return re.findall(r"\(|\)|[^\s()]+", expression)


def accepted(expression: str, allowed: set[str]) -> bool:
    """True if one of the expression's alternatives only uses allowed
    licenses. `A OR B`: one is enough; `A AND B`: both are needed; `A WITH E`
    is a term in its own right, as in `deny.toml`."""
    tokens = _tokens(expression)
    position = 0

    def term() -> bool:
        nonlocal position
        if position >= len(tokens):
            raise ValueError(expression)
        token = tokens[position]
        position += 1
        if token == "(":
            value = parse_or()
            if position >= len(tokens) or tokens[position] != ")":
                raise ValueError(expression)
            position += 1
            return value
        if position + 1 < len(tokens) and tokens[position] == "WITH":
            token = f"{token} WITH {tokens[position + 1]}"
            position += 2
        return token in allowed

    def parse_and() -> bool:
        nonlocal position
        value = term()
        while position < len(tokens) and tokens[position] == "AND":
            position += 1
            value = term() and value
        return value

    def parse_or() -> bool:
        nonlocal position
        value = parse_and()
        while position < len(tokens) and tokens[position] == "OR":
            position += 1
            value = parse_and() or value
        return value

    try:
        value = parse_or()
    except ValueError:
        return False
    return value and position == len(tokens)


# --- What is accepted -----------------------------------------------------------


def deny_licenses() -> set[str]:
    return set(tomllib.loads(DENY.read_text(encoding="utf-8"))["licenses"]["allow"])


@dataclass
class ConfigNpm:
    allowed: set[str]
    exceptions: dict[str, set[str]]
    # (name, version) → license: the package does not declare its own, or
    # declares it wrongly. Pinned to a version: a bump requires rereading.
    details: dict[tuple[str, str], str]


def read_npm_config() -> ConfigNpm:
    raw = tomllib.loads(CONFIG_NPM.read_text(encoding="utf-8"))
    return ConfigNpm(
        allowed=deny_licenses() | set(raw.get("allow", [])),
        exceptions={e["name"]: set(e["allow"]) for e in raw.get("exceptions", [])},
        details={(c["name"], c["version"]): c["license"] for c in raw.get("clarify", [])},
    )


# --- The npm dependencies -----------------------------------------------------


@dataclass
class NpmPackage:
    item_name: str
    version: str
    license_id: str
    path_str: Path


def npm_packages() -> list[NpmPackage]:
    output = subprocess.run(
        ["pnpm", "licenses", "list", "--prod", "--json"],
        cwd=FRONT,
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    packages: list[NpmPackage] = []
    for license_id, entries in json.loads(output).items():
        for entry in entries:
            for version, path_str in zip(entry["versions"], entry["paths"], strict=True):
                packages.append(NpmPackage(entry["name"], version, license_id, Path(path_str)))
    return sorted(packages, key=lambda p: (p.item_name, p.version))


def verify_npm() -> int:
    config = read_npm_config()
    packages = npm_packages()
    refusal: list[str] = []
    used: set[object] = set()
    for package in packages:
        field_key = (package.item_name, package.version)
        license_id = config.details.get(field_key, package.license_id)
        if field_key in config.details:
            used.add(field_key)
        allowed = config.allowed | config.exceptions.get(package.item_name, set())
        if package.item_name in config.exceptions:
            used.add(package.item_name)
        if not accepted(license_id, allowed):
            refusal.append(f"  {package.item_name}@{package.version}: \"{license_id}\"")

    stale = [f"  exception {n}" for n in config.exceptions if n not in used]
    stale += [f"  clarify {n}@{v}" for (n, v) in config.details if (n, v) not in used]

    if refusal:
        print("Refused npm licenses (production dependencies of apps/desktop):")
        print("\n".join(refusal))
        print(
            "\nA license is accepted in deny.toml, after checking that it is\n"
            "compatible with the GPLv3 (ADR-0044); an exception specific to a package,\n"
            "or a wrongly declared license, in apps/desktop/licences-npm.toml."
        )
    if stale:
        print("Entries of apps/desktop/licences-npm.toml that no longer serve:")
        print("\n".join(stale))
    if refusal or stale:
        return 1
    print(f"npm licenses: {len(packages)} production packages, all accepted.")
    return 0


# --- The notices --------------------------------------------------------------


def _host_target() -> str:
    output = subprocess.run(["rustc", "-vV"], check=True, capture_output=True, text=True).stdout
    for line in output.splitlines():
        if line.startswith("host: "):
            return line.removeprefix("host: ")
    raise SystemExit("rustc -vV does not give the host target")


def mentions_rust() -> list[dict[str, object]]:
    """The dependencies of `oxyn-desktop` for the host target, the one of the
    binary being built, without build or development dependencies."""
    target = _host_target()
    # `--frozen` makes the result identical online and offline; it assumes the
    # sources are present, which this `fetch` ensures. Every target: the
    # `cargo metadata` that `cargo about` runs resolves the graph of every
    # platform in the lockfile, and a runner with an empty cache failed on an
    # Android crate.
    subprocess.run(
        ["cargo", "fetch", "--locked", "--manifest-path", str(APP_MANIFEST)],
        cwd=REPO_ROOT,
        check=True,
    )
    with tempfile.TemporaryDirectory() as folder:
        config = Path(folder) / "about.toml"
        config.write_text(
            "accepted = " + json.dumps(sorted(deny_licenses())) + "\n"
            "ignore-build-dependencies = true\n"
            "ignore-dev-dependencies = true\n"
            # Our GPL crates, `publish = false`: same exemption as in
            # deny.toml, and for the same reason.
            "private = { ignore = true }\n",
            encoding="utf-8",
        )
        output = Path(folder) / "rust.json"
        subprocess.run(
            [
                "cargo", "about", "generate", "--format", "json", "--frozen", "--fail",
                "-c", str(config), "-m", str(APP_MANIFEST), "--target", target,
                "-o", str(output),
            ],
            cwd=REPO_ROOT,
            check=True,
        )
        raw = json.loads(output.read_text(encoding="utf-8"))

    mentions: list[dict[str, object]] = []
    for license_id in raw["licenses"]:
        # The workspace crates have no `source`: they are ours, and NOTICE
        # gives their license.
        packages = sorted(
            {
                (u["crate"]["name"], u["crate"]["version"])
                for u in license_id["used_by"]
                if u["crate"].get("source")
            }
        )
        if packages:
            mentions.append(
                {
                    "license": license_id["id"],
                    "name": license_id["name"],
                    "text": license_id["text"].strip("\n"),
                    "packages": [
                        {"ecosystem": "cargo", "name": n, "version": v} for n, v in packages
                    ],
                }
            )
    return mentions


def _license_text(folder: Path) -> str | None:
    if not folder.is_dir():
        return None
    file_list = sorted(f for f in folder.iterdir() if f.is_file() and LICENSE_FILE_PATTERN.match(f.name))
    texts = [f.read_text(encoding="utf-8", errors="replace").strip("\n") for f in file_list]
    return "\n\n".join(texts) or None


def mentions_npm() -> list[dict[str, object]]:
    config = read_npm_config()
    groups: dict[tuple[str, str], list[NpmPackage]] = {}
    for package in npm_packages():
        license_id = config.details.get((package.item_name, package.version), package.license_id)
        # Without a file, the declared expression remains: it is what the
        # package publishes of its license, and hiding it would be worse.
        body = _license_text(package.path_str) or f"Licensed under {license_id}. The package ships no license file."
        groups.setdefault((license_id, body), []).append(package)
    return [
        {
            "license": license_id,
            "name": license_id,
            "text": body,
            "packages": [
                {"ecosystem": "npm", "name": p.item_name, "version": p.version} for p in packages
            ],
        }
        for (license_id, body), packages in groups.items()
    ]


def generate(output: Path, require: bool) -> int:
    tool = shutil.which("cargo-about")
    version = (
        subprocess.run(["cargo", "about", "--version"], capture_output=True, text=True).stdout.split()[-1:]
        if tool
        else []
    )
    if version != [VERSION_CARGO_ABOUT]:
        found = version[0] if version else "missing"
        print(
            f"cargo-about {VERSION_CARGO_ABOUT} required ({found}): the third-party "
            "license notices were NOT generated."
        )
        print(f"  To install it: cargo install --locked cargo-about@{VERSION_CARGO_ABOUT}")
        return 1 if require else 0

    mentions = mentions_rust() + mentions_npm()
    mentions.sort(key=lambda m: (str(m["license"]).lower(), m["packages"][0]["name"]))  # type: ignore[index]
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(
        json.dumps({"version": 1, "notices": mentions}, ensure_ascii=False, indent=1) + "\n",
        encoding="utf-8",
    )
    packages = sum(len(m["packages"]) for m in mentions)  # type: ignore[arg-type]
    print(f"Third-party notices: {packages} packages, {len(mentions)} texts → {output.relative_to(REPO_ROOT)}")
    return 0


def main(arguments: list[str]) -> int:
    if arguments == ["verifier-npm"]:
        return verify_npm()
    if arguments[:1] == ["generer"]:
        rest = arguments[1:]
        require = "--exiger" in rest
        paths = [a for a in rest if a != "--exiger"]
        if len(paths) == 1:
            return generate((REPO_ROOT / paths[0]).resolve(), require)
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
