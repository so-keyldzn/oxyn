#!/usr/bin/env python3
"""Refuses a remaining-work marker that says neither when nor by what.

CLAUDE.md has said it from the start: a remaining-work marker carries a date and
names what unblocks it. A rule of that kind does not hold on its own — the
undated marker breaks nothing, is not seen in review once the file is long, and
after a year becomes a note nobody knows is still true.

Two forms are accepted, because the repository uses both:

    TODO(2026-11-30, unblocked by a typed `OxynError`)   a date
    TODO(phase 4): ...                                    a phase of the plan

Both name what we are waiting for. A phase is a date just as much: the
implementation plan says what it contains, hence when it comes. The
justification may wrap onto the following lines: it is read up to the closing
parenthesis or, failing that, up to the end of the line it starts on.

The words listed in `FORBIDDEN` are refused unconditionally. They are not other
subjects: they are the names given to a marker when one does not want to date
it.

Which files are scanned is written once, next to `SUFFIXES` below.

Called by `make todo`, hence by `make qualite`.
"""

from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]

# Exactly what is scanned — tracked files only, because `target/` and
# `node_modules/` hold thousands of untracked ones and an untracked file commits
# nobody:
#   - by suffix: Rust, Python, TOML, YAML, shell, JSON, WIT and SQL, plus the
#     front end's TypeScript and JavaScript. No `.mjs` or `.cjs` file is tracked
#     today; they are listed so that the first one is covered without anybody
#     remembering to come back here;
#   - by name: the root `Makefile`, and the files without a suffix directly
#     under `script/`, which are Python programs run as commands;
#   - minus `GENERATED_COMPONENTS` and `EXEMPT`, below.
# Documents are not scanned: `docs/` and `.claude/*.md` *describe* the
# convention, they do not violate it by quoting it. It is the same reasoning as
# the one already written in `.claude/hooks/code_interdit.py`.
SUFFIXES = {
    ".rs", ".py", ".toml", ".yml", ".yaml", ".sh", ".json", ".wit", ".sql",
    ".ts", ".tsx", ".js", ".mjs", ".cjs",
}
MAKEFILE = "Makefile"
COMMANDS_DIR = Path("script")

# Generated by `shadcn add` and never edited by hand: what it contains is not
# ours, and the next `--overwrite` would erase any fix made there. The same
# value as `GENERATED_COMPONENTS` in `.claude/hooks/code_interdit.py`.
GENERATED_COMPONENTS = "apps/desktop/src/components/ui/"

# Two files carry the marker because they *are* the check: the hook that
# refuses it on write, and its test. Exempting them is accurate; rewriting them
# to work around this script would make the hook unreadable.
EXEMPT = {
    ".claude/hooks/code_interdit.py",
    ".claude/hooks/test_hooks.py",
}

# The word is assembled instead of written, so that this file does not flag
# itself and does not have to exempt itself — an exemption is a permanent hole.
MARK = "TO" + "DO"
FORBIDDEN = ("FIX" + "ME", "XX" + "X", "HA" + "CK")

# The closing parenthesis is optional on purpose: the formatters wrap a long
# comment, and a dated justification whose `)` sits on a later line would be
# read as having no date. It is the reading of `DEADLINE_PATTERN` in
# `.claude/hooks/code_interdit.py`, which only needs a date or a phase right
# after the opening parenthesis.
MARK_PATTERN = re.compile(r"\b" + MARK + r"\b\s*(?:\(([^)]*)\)?)?")
JUSTIFICATION_PATTERN = re.compile(r"\d{4}-\d{2}-\d{2}|phase\s+\d+", re.IGNORECASE)
# The word boundaries are not decorative: without them, the `XXXX` that marks a
# placeholder in the ADR templates would be taken for a marker.
FORBIDDEN_PATTERN = re.compile(r"\b(?:" + "|".join(FORBIDDEN) + r")\b")


def _is_scanned(name: str) -> bool:
    """Whether a path given by `git ls-files` is in the scanned set."""
    if name in EXEMPT or name.startswith(GENERATED_COMPONENTS):
        return False
    path = Path(name)
    if name == MAKEFILE or path.suffix in SUFFIXES:
        return True
    return path.suffix == "" and path.parent == COMMANDS_DIR


def _tracked_files() -> list[Path]:
    """Only files tracked by git count: `target/` holds thousands, and an
    untracked file commits nobody."""
    output = subprocess.run(
        ["git", "ls-files", "-z"],
        cwd=REPO_ROOT,
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    paths = (REPO_ROOT / item_name for item_name in output.split("\0") if item_name and _is_scanned(item_name))
    return [c for c in paths if c.is_file()]


def run_checks(file_path: Path) -> list[str]:
    problems = []
    rel = file_path.relative_to(REPO_ROOT)
    try:
        lines = file_path.read_text(encoding="utf-8").splitlines()
    except UnicodeDecodeError:
        return []

    for number, line in enumerate(lines, start=1):
        for forbidden in FORBIDDEN_PATTERN.finditer(line):
            problems.append(
                f"{rel}:{number}: \"{forbidden.group(0)}\" — use "
                f"{MARK}(YYYY-MM-DD) or {MARK}(phase N), which say when"
            )
        for mark in MARK_PATTERN.finditer(line):
            content = mark.group(1) or ""
            if not JUSTIFICATION_PATTERN.search(content):
                problems.append(
                    f"{rel}:{number}: {MARK} without a date or a phase — "
                    f"expected {MARK}(YYYY-MM-DD, what unblocks it) "
                    f"or {MARK}(phase N)"
                )
    return problems


def main() -> int:
    problems = [e for file_path in _tracked_files() for e in run_checks(file_path)]

    for message in problems:
        print(f"ERROR          {message}")

    if problems:
        print(f"\n{MARK}: {len(problems)} marker(s) without a deadline.")
        return 1
    print(f"{MARK}: every marker is dated.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
