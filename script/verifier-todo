#!/usr/bin/env python3
"""Refuses a remaining-work marker that says neither when nor by what.

CLAUDE.md has said it from the start: "no TODO without a date and without
naming what unblocks it". A rule of that kind does not hold on its own — the
undated TODO breaks nothing, is not seen in review once the file is long, and
after a year becomes a note nobody knows is still true.

Two forms are accepted, because the repository uses both:

    TODO(2026-11-30, unblocked by a typed `OxynError`)   a date
    TODO(phase 4): ...                                    a phase of the plan

Both name what we are waiting for. A phase is a date just as much: the
implementation plan says what it contains, hence when it comes.

`FIXME`, `XXX` and `HACK` are refused unconditionally. They are not other
subjects: they are the names given to a TODO when one does not want to date it.

Called by `make todo`, hence by `make qualite`.
"""

from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

RACINE = Path(__file__).resolve().parents[1]

# The check covers code and tooling, not documents: `docs/` and `.claude/*.md`
# *describe* the convention, they do not violate it by quoting it. It is the
# same reasoning as the one already written in `.claude/hooks/code_interdit.py`.
SUFFIXES = {".rs", ".py", ".toml", ".yml", ".yaml", ".sh", ".json", ".wit", ".sql"}

# Two files carry the marker because they *are* the check: the hook that
# refuses it on write, and its test. Exempting them is accurate; rewriting them
# to work around this script would make the hook unreadable.
EXEMPTS = {
    ".claude/hooks/code_interdit.py",
    ".claude/hooks/test_hooks.py",
}

# The word is assembled instead of written, so that this file does not flag
# itself and does not have to exempt itself — an exemption is a permanent hole.
MARQUE = "TO" + "DO"
INTERDITS = ("FIX" + "ME", "XX" + "X", "HA" + "CK")

MOTIF_MARQUE = re.compile(r"\b" + MARQUE + r"\b\s*(?:\(([^)]*)\))?")
MOTIF_JUSTIFICATION = re.compile(r"\d{4}-\d{2}-\d{2}|phase\s+\d+", re.IGNORECASE)
# The word boundaries are not decorative: without them, the `XXXX` that marks a
# placeholder in the ADR templates would be taken for a marker.
MOTIF_INTERDIT = re.compile(r"\b(?:" + "|".join(INTERDITS) + r")\b")


def _fichiers_suivis() -> list[Path]:
    """Only files tracked by git count: `target/` holds thousands, and an
    untracked file commits nobody."""
    sortie = subprocess.run(
        ["git", "ls-files", "-z"],
        cwd=RACINE,
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    noms = [nom for nom in sortie.split("\0") if nom and nom not in EXEMPTS]
    chemins = (RACINE / nom for nom in noms)
    return [c for c in chemins if c.suffix in SUFFIXES and c.is_file()]


def controler(fichier: Path) -> list[str]:
    erreurs = []
    rel = fichier.relative_to(RACINE)
    try:
        lignes = fichier.read_text(encoding="utf-8").splitlines()
    except UnicodeDecodeError:
        return []

    for numero, ligne in enumerate(lignes, start=1):
        for interdit in MOTIF_INTERDIT.finditer(ligne):
            erreurs.append(
                f"{rel}:{numero}: \"{interdit.group(0)}\" — use "
                f"{MARQUE}(YYYY-MM-DD) or {MARQUE}(phase N), which say when"
            )
        for marque in MOTIF_MARQUE.finditer(ligne):
            contenu = marque.group(1) or ""
            if not MOTIF_JUSTIFICATION.search(contenu):
                erreurs.append(
                    f"{rel}:{numero}: {MARQUE} without a date or a phase — "
                    f"expected {MARQUE}(YYYY-MM-DD, what unblocks it) "
                    f"or {MARQUE}(phase N)"
                )
    return erreurs


def principal() -> int:
    erreurs = [e for fichier in _fichiers_suivis() for e in controler(fichier)]

    for message in erreurs:
        print(f"ERROR          {message}")

    if erreurs:
        print(f"\n{MARQUE}: {len(erreurs)} marker(s) without a deadline.")
        return 1
    print(f"{MARQUE}: every marker is dated.")
    return 0


if __name__ == "__main__":
    sys.exit(principal())
