#!/usr/bin/env python3
"""Refuse une marque de travail restant qui ne dit pas quand ni par quoi.

CLAUDE.md l'écrit depuis le début : « pas de TODO sans date ni sans nom de ce
qui le débloque ». Une règle de ce genre ne tient pas toute seule — le TODO non
daté ne casse rien, ne se voit pas en revue une fois le fichier long, et devient
au bout d'un an une note dont plus personne ne sait si elle est encore vraie.

Deux formes sont acceptées, parce que le dépôt s'en sert des deux :

    TODO(2026-11-30, débloqué par un `OxynError` typé)   une date
    TODO(phase 4) : ...                                  une phase du plan

Les deux nomment ce qu'on attend. Une phase est une date au même titre : le plan
d'implémentation dit ce qu'elle contient, donc quand elle arrive.

`FIXME`, `XXX` et `HACK` sont refusés sans condition. Ce ne sont pas d'autres
sujets : ce sont les noms qu'on donne au TODO quand on ne veut pas en dater un.

Appelé par `make todo`, donc par `make qualite`.
"""

from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

RACINE = Path(__file__).resolve().parents[1]

# Le contrôle porte sur le code et l'outillage, pas sur les documents : `docs/`
# et `.claude/*.md` *décrivent* la convention, ils ne la violent pas en la
# citant. C'est le même raisonnement que celui déjà écrit dans
# `.claude/hooks/code_interdit.py`.
SUFFIXES = {".rs", ".py", ".toml", ".yml", ".yaml", ".sh", ".json", ".wit", ".sql"}

# Deux fichiers portent la marque parce qu'ils *sont* le contrôle : le hook qui
# la refuse à l'écriture, et son test. Les exempter est exact ; les réécrire
# pour contourner ce script rendrait le hook illisible.
EXEMPTS = {
    ".claude/hooks/code_interdit.py",
    ".claude/hooks/test_hooks.py",
}

# Le mot est assemblé au lieu d'être écrit, pour que ce fichier ne se signale pas
# lui-même et n'ait pas à s'exempter — une exemption est un trou permanent.
MARQUE = "TO" + "DO"
INTERDITS = ("FIX" + "ME", "XX" + "X", "HA" + "CK")

MOTIF_MARQUE = re.compile(r"\b" + MARQUE + r"\b\s*(?:\(([^)]*)\))?")
MOTIF_JUSTIFICATION = re.compile(r"\d{4}-\d{2}-\d{2}|phase\s+\d+", re.IGNORECASE)
# Les bornes de mot ne sont pas décoratives : sans elles, le `XXXX` qui marque
# un emplacement à remplir dans les gabarits d'ADR serait pris pour une marque.
MOTIF_INTERDIT = re.compile(r"\b(?:" + "|".join(INTERDITS) + r")\b")


def _fichiers_suivis() -> list[Path]:
    """Seuls les fichiers suivis par git comptent : `target/` en contient des
    milliers, et un fichier non suivi n'engage personne."""
    sortie = subprocess.run(
        ["git", "ls-files", "-z"],
        cwd=RACINE,
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    noms = [nom for nom in sortie.split("\0") if nom and nom not in EXEMPTS]
    chemins = (RACINE / nom for nom in noms)
    return [c for c in chemins if c.suffix in SUFFIXES and c.is_file()]


def controler(fichier: Path) -> list[str]:
    erreurs = []
    rel = fichier.relative_to(RACINE)
    try:
        lignes = fichier.read_text(encoding="utf-8").splitlines()
    except UnicodeDecodeError:
        return []

    for numero, ligne in enumerate(lignes, start=1):
        for interdit in MOTIF_INTERDIT.finditer(ligne):
            erreurs.append(
                f"{rel}:{numero} : « {interdit.group(0)} » — utiliser "
                f"{MARQUE}(AAAA-MM-JJ) ou {MARQUE}(phase N), qui disent quand"
            )
        for marque in MOTIF_MARQUE.finditer(ligne):
            contenu = marque.group(1) or ""
            if not MOTIF_JUSTIFICATION.search(contenu):
                erreurs.append(
                    f"{rel}:{numero} : {MARQUE} sans date ni phase — "
                    f"attendu {MARQUE}(AAAA-MM-JJ, ce qui le débloque) "
                    f"ou {MARQUE}(phase N)"
                )
    return erreurs


def principal() -> int:
    erreurs = [e for fichier in _fichiers_suivis() for e in controler(fichier)]

    for message in erreurs:
        print(f"ERREUR         {message}")

    if erreurs:
        print(f"\n{MARQUE} : {len(erreurs)} marque(s) sans échéance.")
        return 1
    print(f"{MARQUE} : toutes les marques sont datées.")
    return 0


if __name__ == "__main__":
    sys.exit(principal())
