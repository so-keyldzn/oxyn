#!/usr/bin/env python3
"""Checks what changed since `origin/main`, and only that.

The local counterpart of ADR-0045: on a machine carrying several worktrees,
`make qualite` recompiles and retests the whole workspace for a one-line
change. This script keeps the checks that concern the modified files —
committed or not since the merge base with `origin/main` — and says what it
leaves to CI.

**It does not replace `make qualite`**, which remains the gate: the crates
that depend on a modified crate, the Rust documentation, `cargo deny`, the
unaffected stories and the front-end build do not run here.

Stops at the first failure, with the exit code of the failing command.

Called by `make verif-rapide`.
"""

from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
FRONT = REPO_ROOT / "apps" / "desktop"

# A change here modifies how the whole workspace is built or checked: one can
# no longer reason crate by crate.
RUST_GLOBALS = (
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    "clippy.toml",
    "deny.toml",
)
ESLINT_EXTENSIONS = (".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs")
NAME_PATTERN = re.compile(r'^name\s*=\s*"([^"]+)"', re.MULTILINE)

LEFT_TO_CI = [
    "the crates that depend on the modified crates",
    "cargo doc, cargo deny, and the nextest profile (.config/nextest.toml)",
    "the stories Vitest does not relate to the modified files",
    "the front-end build and the npm licenses",
    "the foundation's hook tests",
    "macOS, on main",
]


def git(*arguments: str) -> str:
    return subprocess.run(
        ["git", *arguments], cwd=REPO_ROOT, check=True, capture_output=True, text=True
    ).stdout


def modified_files(base: str) -> list[str]:
    # `git diff <base>` compares with the working tree: it counts the index and
    # unstaged changes. Untracked files are added to them.
    tracked = git("diff", "--name-only", base).splitlines()
    new_items = git("ls-files", "--others", "--exclude-standard").splitlines()
    return sorted(set(tracked) | set(new_items))


def crate_of(path_str: str) -> str | None:
    """The name of the crate whose `Cargo.toml` is closest to the file."""
    folder = (REPO_ROOT / path_str).parent
    while folder != REPO_ROOT and REPO_ROOT in folder.parents:
        manifest = folder / "Cargo.toml"
        if manifest.is_file():
            item_name = NAME_PATTERN.search(manifest.read_text(encoding="utf-8"))
            return item_name.group(1) if item_name else None
        folder = folder.parent
    return None


def launch(command: list[str], folder: Path = REPO_ROOT) -> None:
    print(f"\n$ {' '.join(command)}", flush=True)
    code = subprocess.run(command, cwd=folder).returncode
    if code != 0:
        print(f"\nFailed: {' '.join(command)} (code {code}).")
        sys.exit(code)


def check_rust(file_list: list[str]) -> None:
    everything = any(f in RUST_GLOBALS or f.startswith(".cargo/") for f in file_list)
    crates = sorted({c for f in file_list if (c := crate_of(f))})
    if not everything and not crates:
        print("\nRust: no crate file modified.")
        return
    if everything:
        print("\nRust: a workspace-wide file changed, the whole workspace is checked.")
        target = ["--workspace"]
    else:
        print(f"\nRust: {', '.join(crates)}.")
        target = [a for c in crates for a in ("-p", c)]

    if (everything or "oxyn-desktop" in crates) and not (FRONT / "dist" / "client").is_dir():
        print("oxyn-desktop embeds apps/desktop/dist/client, which is missing: run `make front-build`.")
        sys.exit(1)

    launch(["cargo", "fmt", "--all", "--", "--check"])
    launch(["cargo", "clippy", *target, "--all-targets", "--all-features", "--", "-D", "warnings"])
    launch(["cargo", "test", *target, "--all-features"])


def check_front(file_list: list[str], base: str) -> None:
    prefix = "apps/desktop/"
    modified = [f[len(prefix):] for f in file_list if f.startswith(prefix)]
    if not modified:
        print("\nFront end: no file modified.")
        return
    existing = [f for f in modified if (FRONT / f).is_file()]
    print(f"\nFront end: {len(modified)} file(s) modified.")

    if not (FRONT / "node_modules").is_dir():
        launch(["pnpm", "install", "--frozen-lockfile"], FRONT)
    launch(["python3", "script/verifier-stories"])
    launch(["pnpm", "exec", "tsc", "--noEmit"], FRONT)
    to_lint = [f for f in existing if f.endswith(ESLINT_EXTENSIONS)]
    if to_lint:
        launch(["pnpm", "exec", "eslint", "--no-warn-ignored", *to_lint], FRONT)
    if existing:
        launch(["pnpm", "exec", "prettier", "--check", "--ignore-unknown", *existing], FRONT)
    launch(["pnpm", "exec", "playwright", "install", "chromium"], FRONT)
    # `--changed <base>` only runs the test files that import, directly or not,
    # a file modified since the base (vitest 4.1.11, RESEARCH-NOTES § npm
    # packages).
    launch(["pnpm", "exec", "vitest", "run", "--changed", base, "--passWithNoTests"], FRONT)


def main() -> int:
    try:
        base = git("merge-base", "origin/main", "HEAD").strip()
    except subprocess.CalledProcessError:
        print("origin/main not found: run `git fetch origin main`.")
        return 1
    file_list = modified_files(base)
    print(f"Base: {base[:12]} (merge-base origin/main HEAD), {len(file_list)} file(s) modified.")
    print("Left to CI and to `make qualite`:")
    for element in LEFT_TO_CI:
        print(f"  - {element}")

    launch(["python3", ".claude/verifier_socle.py"])
    launch(["python3", "script/verifier-todo"])
    check_rust(file_list)
    check_front(file_list, base)

    print("\nQuick check passed. `make qualite` remains the gate.")
    return 0


if __name__ == "__main__":
    os.chdir(REPO_ROOT)
    sys.exit(main())
