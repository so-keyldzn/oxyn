#!/usr/bin/env python3
"""Checks what changed since `origin/main`, and only that.

The local counterpart of ADR-0045: on a machine carrying several worktrees,
`make qualite` recompiles and retests the whole workspace for a one-line
change. This script keeps the checks that concern the modified files —
committed or not since the merge base with `origin/main` — and says what it
leaves to CI.

**It does not replace `make qualite`**, which remains the gate: the crates
that depend on a modified crate, the Rust documentation, `cargo deny`, the
unaffected stories and the front-end build do not run here.

Stops at the first failure, with the exit code of the failing command.

Called by `make verif-rapide`.
"""

from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path

RACINE = Path(__file__).resolve().parents[1]
FRONT = RACINE / "apps" / "desktop"

# A change here modifies how the whole workspace is built or checked: one can
# no longer reason crate by crate.
GLOBAUX_RUST = (
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    "clippy.toml",
    "deny.toml",
)
EXTENSIONS_ESLINT = (".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs")
MOTIF_NOM = re.compile(r'^name\s*=\s*"([^"]+)"', re.MULTILINE)

LAISSE_A_LA_CI = [
    "the crates that depend on the modified crates",
    "cargo doc, cargo deny, and the nextest profile (.config/nextest.toml)",
    "the stories Vitest does not relate to the modified files",
    "the front-end build and the npm licenses",
    "the foundation's hook tests",
    "macOS, on main",
]


def git(*arguments: str) -> str:
    return subprocess.run(
        ["git", *arguments], cwd=RACINE, check=True, capture_output=True, text=True
    ).stdout


def fichiers_modifies(base: str) -> list[str]:
    # `git diff <base>` compares with the working tree: it counts the index and
    # unstaged changes. Untracked files are added to them.
    suivis = git("diff", "--name-only", base).splitlines()
    nouveaux = git("ls-files", "--others", "--exclude-standard").splitlines()
    return sorted(set(suivis) | set(nouveaux))


def crate_de(chemin: str) -> str | None:
    """The name of the crate whose `Cargo.toml` is closest to the file."""
    dossier = (RACINE / chemin).parent
    while dossier != RACINE and RACINE in dossier.parents:
        manifeste = dossier / "Cargo.toml"
        if manifeste.is_file():
            nom = MOTIF_NOM.search(manifeste.read_text(encoding="utf-8"))
            return nom.group(1) if nom else None
        dossier = dossier.parent
    return None


def lancer(commande: list[str], dossier: Path = RACINE) -> None:
    print(f"\n$ {' '.join(commande)}", flush=True)
    code = subprocess.run(commande, cwd=dossier).returncode
    if code != 0:
        print(f"\nFailed: {' '.join(commande)} (code {code}).")
        sys.exit(code)


def controler_rust(fichiers: list[str]) -> None:
    tout = any(f in GLOBAUX_RUST or f.startswith(".cargo/") for f in fichiers)
    crates = sorted({c for f in fichiers if (c := crate_de(f))})
    if not tout and not crates:
        print("\nRust: no crate file modified.")
        return
    if tout:
        print("\nRust: a workspace-wide file changed, the whole workspace is checked.")
        cible = ["--workspace"]
    else:
        print(f"\nRust: {', '.join(crates)}.")
        cible = [a for c in crates for a in ("-p", c)]

    if (tout or "oxyn-desktop" in crates) and not (FRONT / "dist" / "client").is_dir():
        print("oxyn-desktop embeds apps/desktop/dist/client, which is missing: run `make front-build`.")
        sys.exit(1)

    lancer(["cargo", "fmt", "--all", "--", "--check"])
    lancer(["cargo", "clippy", *cible, "--all-targets", "--all-features", "--", "-D", "warnings"])
    lancer(["cargo", "test", *cible, "--all-features"])


def controler_front(fichiers: list[str], base: str) -> None:
    prefixe = "apps/desktop/"
    modifies = [f[len(prefixe):] for f in fichiers if f.startswith(prefixe)]
    if not modifies:
        print("\nFront end: no file modified.")
        return
    existants = [f for f in modifies if (FRONT / f).is_file()]
    print(f"\nFront end: {len(modifies)} file(s) modified.")

    if not (FRONT / "node_modules").is_dir():
        lancer(["pnpm", "install", "--frozen-lockfile"], FRONT)
    lancer(["python3", "script/verifier-stories"])
    lancer(["pnpm", "exec", "tsc", "--noEmit"], FRONT)
    a_linter = [f for f in existants if f.endswith(EXTENSIONS_ESLINT)]
    if a_linter:
        lancer(["pnpm", "exec", "eslint", "--no-warn-ignored", *a_linter], FRONT)
    if existants:
        lancer(["pnpm", "exec", "prettier", "--check", "--ignore-unknown", *existants], FRONT)
    lancer(["pnpm", "exec", "playwright", "install", "chromium"], FRONT)
    # `--changed <base>` only runs the test files that import, directly or not,
    # a file modified since the base (vitest 4.1.11, RESEARCH-NOTES § npm
    # packages).
    lancer(["pnpm", "exec", "vitest", "run", "--changed", base, "--passWithNoTests"], FRONT)


def principal() -> int:
    try:
        base = git("merge-base", "origin/main", "HEAD").strip()
    except subprocess.CalledProcessError:
        print("origin/main not found: run `git fetch origin main`.")
        return 1
    fichiers = fichiers_modifies(base)
    print(f"Base: {base[:12]} (merge-base origin/main HEAD), {len(fichiers)} file(s) modified.")
    print("Left to CI and to `make qualite`:")
    for element in LAISSE_A_LA_CI:
        print(f"  - {element}")

    lancer(["python3", ".claude/verifier_socle.py"])
    lancer(["python3", "script/verifier-todo"])
    controler_rust(fichiers)
    controler_front(fichiers, base)

    print("\nQuick check passed. `make qualite` remains the gate.")
    return 0


if __name__ == "__main__":
    os.chdir(RACINE)
    sys.exit(principal())
